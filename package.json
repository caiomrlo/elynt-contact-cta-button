{
  "name": "elynt-contact-cta-button",
  "version": "1.4.1",
  "description": "WhatsApp, Telegram, and Custom Link CTA button generator for WordPress with modern AJAX admin interface.",
  "private": true,
  "scripts": {
    "lint:js": "wp-scripts lint-js admin/assets/js",
    "lint:js:fix": "wp-scripts lint-js --fix admin/assets/js",
    "lint:css": "wp-scripts lint-style \"admin/assets/css/**/*.css\" \"public/css/**/*.css\"",
    "lint:css:fix": "wp-scripts lint-style --fix \"admin/assets/css/**/*.css\" \"public/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "wp-scripts format admin/assets/js \"admin/assets/css/**/*.css\" \"public/css/**/*.css\"",
    "format:check": "wp-scripts format --check admin/assets/js \"admin/assets/css/**/*.css\" \"public/css/**/*.css\"",
    "test:unit:js": "wp-scripts test-unit-js",
    "test": "npm run lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:reset": "docker compose down -v",
    "docker:phpcs": "docker compose exec -w /var/www/html/wp-content/plugins/elynt-contact-cta-button wordpress phpcs",
    "docker:phpcbf": "docker compose exec -w /var/www/html/wp-content/plugins/elynt-contact-cta-button wordpress phpcbf"
  },
  "devDependencies": {
    "@wordpress/scripts": "^35.0.0"
  }
}